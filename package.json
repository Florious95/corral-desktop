{
  "name": "agentmirror-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentMirror macOS desktop client — mirrors tmux-hosted Agent CLI sessions over WebSocket (protocol v1)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"test/*.test.js\"",
    "tauri": "tauri",
    "core:init": "git submodule update --init deps/corral-core",
    "core:check": "node scripts/check-core.mjs",
    "pretest": "npm run core:check",
    "prebuild": "npm run core:check",
    "predev": "npm run core:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@xterm/addon-webgl": "0.20.0-beta.298",
    "@xterm/xterm": "^6.0.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  },
  "overrides": {
    "@xterm/addon-webgl": {
      "@xterm/xterm": "6.0.0"
    }
  }
