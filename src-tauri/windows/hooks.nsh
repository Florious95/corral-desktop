; AgentMirror WSL cleanup. Enumerate every WSL distribution so uninstall
; cannot leave a daemon behind when Ubuntu is not the default distribution.
; The encoded PowerShell payload avoids NSIS/Windows/WSL quoting collisions.
!macro NSIS_HOOK_PREUNINSTALL
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
!macroend
